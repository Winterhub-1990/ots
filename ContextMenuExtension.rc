#include <windows.h>
#include "resource.h"

LANGUAGE LANG_NEUTRAL, SUBLANG_NEUTRAL

// Icon resources
// IDI_MENU_ICON ICON "menu_icon.ico"

// String resources
STRINGTABLE
BEGIN
    IDS_MENU_TITLE    "Document Tools"
    IDS_MENU_CONVERT  "Convert Document"
    IDS_MENU_EXPORT   "Export Document"
    IDS_SUBMENU_1     "Command 1"
    IDS_SUBMENU_2     "Command 2"
    IDS_SUBMENU_3     "Command 3"
END

// Version information
1 VERSIONINFO
FILEVERSION 1,0,0,1
PRODUCTVERSION 1,0,0,1
FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
FILEFLAGS 0x1L
#else
FILEFLAGS 0x0L
#endif
FILEOS 0x40004L
FILETYPE 0x2L
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "Context Menu Extension"
            VALUE "FileVersion", "1.0.0.1"
            VALUE "InternalName", "ContextMenuExtension.dll"
            VALUE "LegalCopyright", "Copyright (C) 2025"
            VALUE "OriginalFilename", "ContextMenuExtension.dll"
            VALUE "ProductName", "Context Menu Extension"
            VALUE "ProductVersion", "1.0.0.1"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END 